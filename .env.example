# Fuellhorn - Environment Configuration
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy this file to .env and configure your secrets
# NEVER commit .env to version control!

# =============================================================================
# Application
# =============================================================================
DEBUG=false
HOST=0.0.0.0
PORT=8080
# SQL-Statements samt Parametern loggen (nur zur Fehlersuche, schreibt Hashes/Tokens ins Log)
SQL_ECHO=false

# =============================================================================
# Security - REQUIRED!
# =============================================================================
# FUELLHORN_SECRET signiert die Session-Cookies (NiceGUI storage_secret).
# Rotation meldet alle Nutzer ab, Passwörter bleiben gültig.
# Generieren: python -c "import secrets; print(secrets.token_urlsafe(32))"
FUELLHORN_SECRET=nicegui-storage-secret-CHANGE-ME

# =============================================================================
# Database - Local Development (SQLite)
# =============================================================================
DB_TYPE=sqlite
DATABASE_URL=sqlite:///data/fuellhorn.db
# Datenverzeichnis für die SQLite-Datei, wenn DATABASE_URL nicht gesetzt ist
# (Default: ./data relativ zum Arbeitsverzeichnis; im Container /app/data)
# FUELLHORN_DATA_DIR=/app/data

# =============================================================================
# Database - Docker Compose (PostgreSQL)
# =============================================================================
# For docker-compose usage, these are set automatically via environment.
# See docs/deployment/docker.md for full documentation.
# DB_TYPE=postgresql
# DATABASE_URL=postgresql://fuellhorn:your-db-password@db:5432/fuellhorn

# PostgreSQL settings (used by docker-compose.yml)
POSTGRES_USER=fuellhorn
POSTGRES_PASSWORD=CHANGE_ME_generate_db_password
POSTGRES_DB=fuellhorn

# External port for docker-compose (default: 8080)
APP_PORT=8080

# =============================================================================
# Reverse Proxy
# =============================================================================
# Kommagetrennte IPs von Reverse-Proxys (z.B. Traefik, nginx, Ingress), deren
# X-Forwarded-For-Header für das Login-Rate-Limiting vertraut wird.
# Leer = keinem Proxy vertrauen (direkte Client-IP zählt). Ohne diesen Eintrag
# könnte jeder Client das Rate-Limiting per gefälschtem Header umgehen.
TRUSTED_PROXIES=

# =============================================================================
# Session
# =============================================================================
SESSION_MAX_AGE=86400
REMEMBER_ME_MAX_AGE=2592000
