# Fuellhorn - Lebensmittelvorrats-Verwaltung
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Development Dockerfile - builds from source

FROM ghcr.io/astral-sh/uv:python3.14-trixie-slim

WORKDIR /app

# Copy dependency files first for better caching
COPY pyproject.toml uv.lock ./

# Install dependencies only, not the project itself
# This allows volume mounting ./app for live code reloading
RUN uv sync --frozen --no-dev --no-install-project

# Copy application code
COPY app/ ./app/
COPY alembic.ini ./
COPY main.py ./

# Nicht als root laufen (#377); Daten- und NiceGUI-Storage-Verzeichnis beschreibbar
RUN groupadd --system --gid 1000 fuellhorn \
    && useradd --system --uid 1000 --gid 1000 --home-dir /app --no-create-home --shell /usr/sbin/nologin fuellhorn \
    && mkdir -p /app/data /app/.nicegui \
    && chown -R fuellhorn:fuellhorn /app
USER fuellhorn

EXPOSE 8080

# --no-sync: Die Umgebung ist bereits vollständig. Ohne das Flag würde uv das Projekt
# editable bauen, was ohne .git im Build-Kontext an hatch-vcs scheitert (#373).
CMD ["uv", "run", "--no-sync", "python", "main.py"]
